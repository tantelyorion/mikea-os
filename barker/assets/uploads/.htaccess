# ============================================================
# BARKER — Empêche l'exécution de tout script dans ce dossier
# et ses sous-dossiers (media/, polls/, messages/, avatars/, ...).
# Défense en profondeur : même si un fichier malveillant passait
# la validation applicative, il ne pourrait jamais être exécuté ici.
# ============================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|php[0-9]?|phtml|pht|phar|cgi|pl|py|sh|asp|aspx|exe|dll|jsp)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Apache 2.2 (anciens hébergements mutualisés)
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|php[0-9]?|phtml|pht|phar|cgi|pl|py|sh|asp|aspx|exe|dll|jsp)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Ceinture et bretelles si mod_php est actif sur ce dossier
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
